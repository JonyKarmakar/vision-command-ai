# Backend environment variables for VisionCommand AI
#
# Copy this file to backend/.env only for local non-Docker backend development.
# Docker Compose already provides its own backend environment values through docker-compose.yml and backend/Dockerfile.
# Do not commit real .env files, API keys, production credentials, or managed database URLs.

# PostgreSQL connection string.
#
# Default local non-Docker behavior:
# Leave this empty when you want the backend to run with safe not_configured database fallback behavior.
DATABASE_URL=
#
# Local non-Docker with PostgreSQL exposed on localhost:
# DATABASE_URL=postgresql://vision_user:vision_password@127.0.0.1:5432/vision_command
#
# Local Docker Compose backend value:
# DATABASE_URL=postgresql://vision_user:vision_password@postgres:5432/vision_command
#
# Production or managed database:
# Use the provider-generated PostgreSQL connection string as a backend-only secret.
# Never expose DATABASE_URL to the frontend.

# Runtime storage root used by the backend for uploads, outputs, videos, logs, and local model cache.
#
# Local non-Docker default:
STORAGE_ROOT=storage
#
# Container default:
# STORAGE_ROOT=/app/storage

# YOLO model name or path used by Ultralytics.
#
# Local non-Docker example:
MODEL_NAME=yolo26n.pt
#
# Local Docker container default from backend/Dockerfile:
# MODEL_NAME=/app/storage/models/yolo26n.pt
#
# Model files are ignored by Git.
# Do not commit .pt model artifacts.

# LLM provider selection.
#
# Supported values:
# - disabled
# - openai
# - ollama
#
# Recommended default:
LLM_PROVIDER=disabled

# OpenAI provider configuration.
#
# Required only when LLM_PROVIDER=openai.
# Keep OPENAI_API_KEY backend-only.
# Never expose this value to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama provider configuration.
#
# Required only when LLM_PROVIDER=ollama.
# Best suited for local or self-hosted environments.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Backend server port.
#
# Local/default:
PORT=8000
#
# Some cloud platforms provide PORT automatically.
# In that case, do not override it unless the platform requires manual configuration.

# Python logging/output behavior.
# Useful for Docker logs.
PYTHONUNBUFFERED=1
