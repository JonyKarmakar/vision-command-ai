# Backend environment variables for VisionCommand AI
#
# Copy this file to backend/.env for local development.
# Do not commit real .env files, API keys, or production credentials.

# PostgreSQL connection string.
#
# Local Docker Compose example:
# DATABASE_URL=postgresql://vision_user:vision_password@postgres:5432/vision_command
#
# Local non-Docker example:
# DATABASE_URL=postgresql://vision_user:vision_password@127.0.0.1:5432/vision_command
#
# Production:
# Use the managed PostgreSQL connection string from the hosting/database provider.
DATABASE_URL=postgresql://vision_user:vision_password@postgres:5432/vision_command

# LLM provider selection.
#
# Supported values:
# - disabled
# - openai
# - ollama
#
# Recommended default for local development:
# LLM_PROVIDER=disabled
#
# Recommended first cloud deployment option:
# LLM_PROVIDER=openai
LLM_PROVIDER=disabled

# OpenAI provider configuration.
#
# Required only when LLM_PROVIDER=openai.
# Keep OPENAI_API_KEY backend-only.
# Never expose this value to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama provider configuration.
#
# Required only when LLM_PROVIDER=ollama.
# Best suited for local or self-hosted environments.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Python logging/output behavior.
# Useful for Docker logs.
PYTHONUNBUFFERED=1
