# Frontend environment variables for VisionCommand AI
#
# Copy this file to frontend/.env only for local frontend development.
# Do not put secrets in frontend environment variables.
# Vite frontend variables are public to the browser.

# VITE_BACKEND_URL is used by the Vite development server proxy.
# The React app itself uses relative /api/... requests.
#
# Local non-Docker frontend development:
VITE_BACKEND_URL=http://127.0.0.1:8000
#
# Docker Compose development:
# Docker Compose provides this value inside the frontend container:
# VITE_BACKEND_URL=http://backend:8000
#
# Production static hosting:
# The current built frontend uses relative /api/... calls.
# Use hosting rewrite/proxy rules from /api/* to the backend.
# Do not use frontend variables for backend secrets.
