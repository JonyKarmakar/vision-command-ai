# Frontend environment variables for VisionCommand AI
#
# Copy this file to frontend/.env for local development.
# Do not put secrets in frontend environment variables.
# Vite frontend variables are public to the browser.

# Backend API base URL used by Vite proxy/config.
#
# Local non-Docker development:
# VITE_BACKEND_URL=http://127.0.0.1:8000
#
# Docker Compose development:
# VITE_BACKEND_URL=http://backend:8000
#
# Production:
# VITE_BACKEND_URL=https://<deployed-backend-url>
VITE_BACKEND_URL=http://127.0.0.1:8000
